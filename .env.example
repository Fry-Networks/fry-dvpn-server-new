# dVPN Server Configuration
# Copy this file to .env and set secure values

# REQUIRED: API authentication token for the dVPN REST API
# Generate with: openssl rand -base64 32
DVPN_API_TOKEN=your-secure-api-token-here

# REQUIRED: WireGuard REST API authentication token
# Generate with: openssl rand -base64 32
WGREST_AUTH_TOKEN=your-secure-wgrest-token-here

# Rate limiting configuration
RATE_LIMIT_REQUESTS=10          # Max requests per window
RATE_LIMIT_WINDOW=3600          # Window in seconds (1 hour)
MAX_PEERS_PER_IP=5              # Max VPN peers per source IP
